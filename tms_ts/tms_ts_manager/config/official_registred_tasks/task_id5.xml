<?xml version="1.0"?>
<root main_tree_to_execute="BehaviorTree">
    <!-- ////////// -->
    <BehaviorTree ID="BehaviorTree">
        <Repeat num_cycles="2">
            <Sequence>
                <Parallel failure_threshold="1" success_threshold="2">
                    <Action  model_name="zx200" ID="LeafNodeExcavator" record_name="initial_pose" primitive_name="primitive_excavator_change_pose"/>
                    <Action  model_name="ic120" ID="LeafNodeCrawlerDump" record_name="LOAD_PATH_1" primitive_name="primitive_crawlerdump_follow_waypoints"/>
                </Parallel>
                <Repeat num_cycles="1">
                    <Sequence>
                        <Action  model_name="zx200" ID="LeafNodeExcavator" record_name="target_excavate_pose" primitive_name="primitive_excavator_excavate_simple"/>
                        <Action  model_name="zx200" ID="LeafNodeExcavator" record_name="hold_soil_while_elevating_pose" primitive_name="primitive_excavator_change_pose"/>
                        <Action  model_name="zx200" ID="LeafNodeExcavator" record_name="hold_soil_while_turning_pose" primitive_name="primitive_excavator_change_pose"/>
                        <Action  model_name="zx200" ID="LeafNodeExcavator" record_name="target_release_pose" primitive_name="primitive_excavator_change_pose"/>
                        <Action  model_name="zx200" ID="LeafNodeExcavator" record_name="release_angle" primitive_name="primitive_excavator_release_simple"/>
                    </Sequence>
                </Repeat>
                <Parallel failure_threshold="1" success_threshold="2">
                    <Action  model_name="zx200" ID="LeafNodeExcavator" record_name="initial_pose" primitive_name="primitive_excavator_change_pose"/>
                    <Sequence>
                        <Action  model_name="ic120" ID="LeafNodeCrawlerDump" record_name="RELEASE_PATH" primitive_name="primitive_crawlerdump_follow_waypoints"/>
                        <Action  model_name="ic120" ID="LeafNodeCrawlerDump" record_name="LOAD_PATH_2" primitive_name="primitive_crawlerdump_follow_waypoints"/>
                    </Sequence>
                </Parallel>
            </Sequence>
        </Repeat>
    </BehaviorTree>
    <!-- ////////// -->
    <TreeNodesModel>
        <Action ID="LeafNodeCrawlerDump">
            <input_port name="model_name"/>
            <inout_port name="record_name"/>
            <inout_port name="primitive_name"/>
        </Action>
        <Action ID="LeafNodeExcavator">
            <input_port default="zx200" name="model_name"/>
            <inout_port name="record_name"/>
            <inout_port name="primitive_name"/>
        </Action>
    </TreeNodesModel>
    <!-- ////////// -->
</root>
