<root>
    <TreeNodesModel>

        <Action ID="LeafNodeBulldozer">
            <input_port name="model_name" default="d37pxi_24"/>
            <inout_port name="record_name"/>
            <inout_port name="primitive_name"/> 
        </Action>
        
        
        <Action ID="LeafNodeCrawlerDump">
            <input_port name="model_name"/>
            <inout_port name="record_name"/>
            <inout_port name="primitive_name"/> 
            <inout_port name="read_direction"/> 
        </Action>

        <Action ID="LeafNodeExcavator">
            <input_port name="model_name" default="zx200"/>
            <inout_port name="previous_target_record_name"/>
            <inout_port name="target_record_name"/>
            <inout_port name="primitive_name"/> 
        </Action>

        <Action ID="LeafNodeExcavatorAssist">
            <input_port name="model_name" default="zx200"/>
            <inout_port name="record_name"/>
            <inout_port name="primitive_name"/> 
        </Action>

        <Action ID="BlackboardValueReaderMongo">
            <input_port name="mongo_param_name"/>
            <input_port name="mongo_record_name"/>
            <input_port name="output_port"/>
        </Action>

        <Action ID="BlackboardValueSearcherMongo">
            <input_port name="mongo_param_name"/>
            <input_port name="mongo_value"/>
            <input_port name="output_port"/>
        </Action>
    
        <Action ID="MongoValueWriter">
            <input_port name="mongo_param_name"/>
            <input_port name="mongo_record_name"/>
            <input_port name="input_value"/>
        </Action>

        <Action ID="ConditionalExpression">
            <input_port name="conditional_expression"/>
        </Action>        

        <Decorator ID="KeepRunningUntilFlgup">
            <input_port name="key"/>        
            <input_port name="while_or_dowhile"/>
        </Decorator>     

        <Action ID="SetLocalBlackboard">
            <input_port name="value"/>
            <inout_port name="output_key"/>
        </Action>          

        <Action ID="SetLocalBlackboardWithCounter">
            <input_port name="key"/>
            <inout_port name="counter_key"/>
        </Action>      

        <Action ID="Counter">
            <input_port name="key"/>
        </Action>     

        <Action ID="WaitForClick">
            <input_port name="window_title"/>
            <input_port name="button_info"/>
        </Action>  

        <!-- <Action ID="WaitForTopic">
            <input_port name="topic_name"/>
        </Action>    -->

        <Action ID="LeafNodeCommon">
            <input_port name="model_name"/>
            <inout_port name="record_name"/>
            <inout_port name="primitive_name"/> 
        </Action>   

        <Action ID="ExecuteSubtask">
            <input_port name="model_name"/>
            <input_port name="subtask_name"/>
            <input_port name="machine_record_name"/>
            <input_port name="terminate_condition"/>
            <input_port name="subtask_parameters"/>
        </Action>


    </TreeNodesModel>
</root>

