<?xml version="1.0"?>
<root main_tree_to_execute="BehaviorTree">
    <!-- ////////// -->
    <BehaviorTree ID="BehaviorTree">
        <Sequence>
            <Action  model_name="mst110cr" ID="LeafNodeCrawlerDump" record_name="SAMPLE_GOAL" primitive_name="primitive_crawlerdump_navigate_anywhere"/>
            <Action  model_name="mst110cr" ID="LeafNodeCrawlerDump" record_name="SAMPLE_PATH1" primitive_name="primitive_crawlerdump_follow_waypoints"/>
            <Action  model_name="mst110cr_2" ID="LeafNodeCrawlerDump" record_name="SAMPLE_PATH2" primitive_name="primitive_crawlerdump_follow_waypoints"/>
        </Sequence>
    </BehaviorTree>
    <!-- ////////// -->
    <TreeNodesModel>
        <Action ID="MongoValueReader">
            <input_port name="mongo_param_name"/>
            <input_port name="mongo_record_name"/>
            <input_port name="output_port"/>
        </Action>
        <Action ID="ConditionalExpression">
            <input_port name="conditional_expression"/>
        </Action>
        <Decorator ID="KeepRunningUntilFlgup">
            <input_port name="key"/>
        </Decorator>
        <Action ID="LeafNodeCrawlerDump">
            <input_port name="model_name"/>
            <inout_port name="record_name"/>
            <inout_port name="primitive_name"/>
        </Action>
        <Action ID="LeafNodeExcavator">
            <input_port default="zx200" name=" model_name"/>
            <inout_port name="record_name"/>
            <inout_port name="primitive_name"/>
        </Action>
        <Action ID="MongoValueWriter">
            <input_port name="input_value"/>
            <input_port name="mongo_param_name"/>
            <input_port name="mongo_record_name"/>
        </Action>
        <Action ID="SetLocalBlackboard">
            <inout_port name="output_key"/>
            <input_port name="value"/>
        </Action>
    </TreeNodesModel>
    <!-- ////////// -->
</root>
