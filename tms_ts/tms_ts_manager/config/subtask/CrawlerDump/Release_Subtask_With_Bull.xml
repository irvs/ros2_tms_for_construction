<?xml version="1.0"?>
<root main_tree_to_execute="BehaviorTree">
    <!-- ////////// -->
    <BehaviorTree ID="BehaviorTree">
        <Sequence>
            <Sequence>
                <Action ID="MongoValueReader" mongo_param_name="RELEACED_BLOCK" mongo_record_name="$release_area_data$" output_port="RELEACED_BLOCK"/>
                <Action ID="MongoValueReader" mongo_param_name="LATEST_RELEACED_BLOCK" mongo_record_name="$release_area_data$" output_port="LATEST_RELEACED_BLOCK"/>
                <Sequence>
                    <IfThenElse>
                        <Action ID="ConditionalExpression" conditional_expression="LATEST_RELEACED_BLOCK == &quot;&quot;"/>
                        <Sequence>
                            <Action ID="SetLocalBlackboard" output_key="LATEST_RELEACED_BLOCK" value="$block_point$"/>
                            <Action ID="SetLocalBlackboard" output_key="dump_waypoint" value="$stop_point$"/>
                            <Action ID="SetLocalBlackboard" output_key="0" value="releace_block_num"/>
                        </Sequence>
                        <AlwaysSuccess/>
                    </IfThenElse>
                </Sequence>
                <Sequence>
                    <Action ID="Counter" key="releace_block_num"/>
                    <Action ID="SetLocalBlackboardWithCounter" counter_key="releace_block_num" key="LATEST_RELEACED_BLOCK"/>
                    <Action ID="SetLocalBlackboardWithCounter" counter_key="releace_block_num" key="dump_waypoint"/>
                </Sequence>
            </Sequence>
            <Sequence>
                <Action ID="LeafNodeCrawlerDump" model_name="$model_name$" primitive_name="primitive_crawlerdump_follow_waypoints" read_direction="up" record_name="dump_waypoint"/>
                <Action ID="LeafNodeCrawlerDump" model_name="$model_name$" primitive_name="primitive_crawlerdump_release_soil" read_direction="" record_name="$dump_up_angle$"/>
                <Delay delay_msec="$time$">
                    <Action ID="LeafNodeCrawlerDump" model_name="$model_name$" primitive_name="primitive_crawlerdump_release_soil" read_direction="" record_name="$dump_down_angle$"/>
                </Delay>
                <Action ID="LeafNodeCrawlerDump" model_name="$model_name$" primitive_name="primitive_crawlerdump_follow_waypoints" read_direction="down" record_name="dump_waypoint"/>
            </Sequence>
            <Sequence>
                <Action ID="MongoArrayWriter" input_value="" mongo_param_name="RELEACED_BLOCK" mongo_record_name="$release_area_data$" operation="add"/>
                <Action ID="MongoValueWriter" input_type="string" input_value="LATEST_RELEACED_BLOCK" mongo_param_name="LATEST_RELEACED_BLOCK" mongo_record_name="$release_area_data$"/>
            </Sequence>
        </Sequence>
    </BehaviorTree>
    <!-- ////////// -->
    <TreeNodesModel>
        <Action ID="ConditionalExpression">
            <input_port name="conditional_expression"/>
        </Action>
        <Action ID="Counter">
            <input_port name="key"/>
        </Action>
        <Action ID="ExecuteSubtask">
            <input_port name="machine_record_name"/>
            <input_port name="model_name"/>
            <input_port name="subtask_name"/>
            <input_port name="subtask_parameters"/>
            <input_port name="terminate_condition"/>
        </Action>
        <Decorator ID="KeepRunningUntilFlgup">
            <input_port name="key"/>
            <input_port name="while_or_dowhile"/>
        </Decorator>
        <Action ID="LeafNodeBulldozer">
            <inout_port name="blade_hold"/>
            <input_port default="d37pxi_24" name="model_name"/>
            <inout_port name="primitive_name"/>
            <inout_port name="record_name"/>
        </Action>
        <Action ID="LeafNodeCommon">
            <input_port name="model_name"/>
            <inout_port name="primitive_name"/>
            <inout_port name="record_name"/>
        </Action>
        <Action ID="LeafNodeCrawlerDump">
            <input_port name="model_name"/>
            <inout_port name="primitive_name"/>
            <inout_port name="read_direction"/>
            <inout_port name="record_name"/>
        </Action>
        <Action ID="LeafNodeExcavator">
            <input_port default="zx200" name="model_name"/>
            <inout_port name="previous_target_record_name"/>
            <inout_port name="primitive_name"/>
            <inout_port name="target_record_name"/>
        </Action>
        <Action ID="LeafNodeExcavatorAssist">
            <input_port default="zx200" name="model_name"/>
            <inout_port name="primitive_name"/>
            <inout_port name="record_name"/>
        </Action>
        <Action ID="LocalBlackboardCaluculator">
            <input_port name="calculation_formula"/>
            <inout_port name="output_key"/>
        </Action>
        <Action ID="MongoArrayWriter">
            <input_port name="input_value"/>
            <input_port name="mongo_param_name"/>
            <input_port name="mongo_record_name"/>
            <input_port name="operation"/>
        </Action>
        <Action ID="MongoValueReader">
            <input_port name="mongo_param_name"/>
            <input_port name="mongo_record_name"/>
            <input_port name="output_port"/>
        </Action>
        <Action ID="MongoValueSearcher">
            <input_port name="mongo_param_name"/>
            <input_port name="mongo_value"/>
            <input_port name="output_port"/>
        </Action>
        <Action ID="MongoValueWriter">
            <input_port name="input_type"/>
            <input_port name="input_value"/>
            <input_port name="mongo_param_name"/>
            <input_port name="mongo_record_name"/>
        </Action>
        <Action ID="SetLocalBlackboard">
            <inout_port name="output_key"/>
            <input_port name="value"/>
        </Action>
        <Action ID="SetLocalBlackboardWithCounter">
            <inout_port name="counter_key"/>
            <input_port name="key"/>
        </Action>
        <Action ID="WaitForClick">
            <input_port name="button_info"/>
            <input_port name="window_title"/>
        </Action>
        <Action ID="WaitTimer">
            <input_port name="seconds"/>
        </Action>
    </TreeNodesModel>
    <!-- ////////// -->
</root>
