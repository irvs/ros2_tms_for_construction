<?xml version="1.0"?>
<root main_tree_to_execute="BehaviorTree">
    <!-- ////////// -->
    <BehaviorTree ID="BehaviorTree">
        <Sequence>
            <Action ID="SetLocalBlackboard" output_key="SUBTASK_TERMINAL_FLG" value="false"/>
            <Action ID="SetLocalBlackboard" output_key="arrival_flg" value="false"/>
            <Decorator ID="KeepRunningUntilFlgup" key="SUBTASK_TERMINAL_FLG" while_or_dowhile="while">
                <Sequence>
                    <IfThenElse>
                        <Action ID="ConditionalExpression" conditional_expression="arrival_flg == false"/>
                        <Sequence>
                            <Action ID="SetLocalBlackboard" output_key="loaded_excavator_record" value="$EXCAVATOR_RECORD$"/>
                            <Sequence>
                                <Action ID="MongoValueReader" mongo_param_name="load_point" mongo_record_name="loaded_excavator_record" output_port="load_point_num"/>
                                <Action ID="SetLocalBlackboard" output_key="loaded_point" value="$LOADED_POINT$"/>
                                <Action ID="SetLocalBlackboardWithCounter" counter_key="load_point_num" key="loaded_point"/>
                            </Sequence>
                            <Action ID="LeafNodeCrawlerDump" model_name="$model_name$" primitive_name="primitive_crawlerdump_navigate_anywhere" read_direction="" record_name="{loaded_point}"/>
                            <Action ID="LeafNodeCrawlerDump" model_name="$model_name$" primitive_name="primitive_crawlerdump_swing" read_direction="" record_name=""/>
                            <SetBlackboard output_key="arrival_flg" value="true"/>
                            <Action ID="MongoValueWriter" input_type="" input_value="arrival_flg" mongo_param_name="arrival_flg" mongo_record_name="loaded_excavator_record"/>
                        </Sequence>
                        <AlwaysSuccess/>
                    </IfThenElse>
                    <Action ID="MongoValueReader" mongo_param_name="loaded_flg" mongo_record_name="loaded_excavator_record" output_port="loaded_flg"/>
                    <IfThenElse>
                        <Action ID="ConditionalExpression" conditional_expression="arrival_flg == true and loaded_flg == true"/>
                        <Sequence>
                            <Action ID="LeafNodeCrawlerDump" model_name="$model_name$" primitive_name="primitive_crawlerdump_swing" read_direction="" record_name=""/>
                            <Action ID="MongoRouteOrientationUpdater" model_name="$model_name$" read_direction="up" record_name=""/>
                            <Action ID="LeafNodeCrawlerDump" model_name="$model_name$" primitive_name="primitive_crawlerdump_follow_waypoints" read_direction="up" record_name=""/>
                            <Action ID="SetLocalBlackboard" output_key="SUBTASK_TERMINAL_FLG" value="true"/>
                        </Sequence>
                        <AlwaysSuccess/>
                    </IfThenElse>
                </Sequence>
            </Decorator>
            <Action ID="SetLocalBlackboard" output_key="SUBTASK_TERMINAL_FLG" value="false"/>
        </Sequence>
    </BehaviorTree>
    <!-- ////////// -->
    <TreeNodesModel>
        <Action ID="BulldozerPathCreater">
            <input_port name="block_data"/>
            <inout_port name="bull_data"/>
        </Action>
        <Action ID="ConditionalExpression">
            <input_port name="conditional_expression"/>
        </Action>
        <Action ID="Counter">
            <input_port name="key"/>
        </Action>
        <Action ID="ExecuteSubtask">
            <input_port name="machine_record_name"/>
            <input_port name="model_name"/>
            <input_port name="subtask_name"/>
            <input_port name="subtask_parameters"/>
            <input_port name="terminate_condition"/>
        </Action>
        <Action ID="ExtractTrailingNumberToBlackboard">
            <inout_port name="source_key"/>
            <inout_port name="stored_key"/>
        </Action>
        <Decorator ID="KeepRunningUntilFlgup">
            <input_port name="key"/>
            <input_port name="while_or_dowhile"/>
        </Decorator>
        <Action ID="LeafNodeBulldozer">
            <inout_port name="blade_hold"/>
            <input_port default="d37pxi_24" name="model_name"/>
            <inout_port name="primitive_name"/>
            <inout_port name="record_name"/>
        </Action>
        <Action ID="LeafNodeCommon">
            <input_port name="model_name"/>
            <inout_port name="primitive_name"/>
            <inout_port name="record_name"/>
        </Action>
        <Action ID="LeafNodeCrawlerDump">
            <input_port name="model_name"/>
            <inout_port name="primitive_name"/>
            <inout_port name="read_direction"/>
            <inout_port name="record_name"/>
        </Action>
        <Action ID="LeafNodeExcavator">
            <input_port default="zx200" name="model_name"/>
            <inout_port name="previous_target_record_name"/>
            <inout_port name="primitive_name"/>
            <inout_port name="target_record_name"/>
        </Action>
        <Action ID="LeafNodeExcavatorAssist">
            <input_port default="zx200" name="model_name"/>
            <inout_port name="primitive_name"/>
            <inout_port name="record_name"/>
        </Action>
        <Action ID="LocalBlackboardCaluculator">
            <input_port name="calculation_formula"/>
            <inout_port name="output_key"/>
        </Action>
        <Action ID="MongoArrayReader">
            <input_port name="mongo_param_name"/>
            <input_port name="mongo_record_name"/>
            <input_port name="output_port"/>
            <inout_port name="output_type"/>
        </Action>
        <Action ID="MongoArrayWriter">
            <input_port name="input_value"/>
            <input_port name="mongo_param_name"/>
            <input_port name="mongo_record_name"/>
            <input_port name="operation"/>
        </Action>
        <Action ID="MongoRouteOrientationUpdater">
            <input_port name="model_name"/>
            <inout_port name="read_direction"/>
            <input_port name="record_name"/>
        </Action>
        <Action ID="MongoValueReader">
            <input_port name="mongo_param_name"/>
            <input_port name="mongo_record_name"/>
            <input_port name="output_port"/>
        </Action>
        <Action ID="MongoValueSearcher">
            <input_port name="mongo_param_name"/>
            <input_port name="mongo_value"/>
            <input_port name="output_port"/>
        </Action>
        <Action ID="MongoValueWriter">
            <input_port name="input_type"/>
            <input_port name="input_value"/>
            <input_port name="mongo_param_name"/>
            <input_port name="mongo_record_name"/>
        </Action>
        <Action ID="SetCurrentTimeToLocalBlackboard">
            <input_port name="output_key"/>
        </Action>
        <Action ID="SetLocalBlackboard">
            <inout_port name="output_key"/>
            <input_port name="value"/>
        </Action>
        <Action ID="SetLocalBlackboardWithCounter">
            <inout_port name="counter_key"/>
            <input_port name="key"/>
        </Action>
        <Action ID="WaitForClick">
            <input_port name="button_info"/>
            <input_port name="window_title"/>
        </Action>
        <Action ID="WaitTimer">
            <input_port name="seconds"/>
        </Action>
    </TreeNodesModel>
    <!-- ////////// -->
</root>
