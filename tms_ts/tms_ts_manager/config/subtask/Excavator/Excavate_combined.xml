<?xml version="1.0"?>
<root main_tree_to_execute="BehaviorTree">
    <!-- ////////// -->
    <BehaviorTree ID="BehaviorTree">
        <Sequence>
            <Action  model_name="zx200" ID="LeafNodeExcavator" previous_target_record_name="" primitive_name="primitive_excavator_change_pose_plan" target_record_name="target_excavate_pose_1"/>
            <Action  model_name="zx200" ID="LeafNodeExcavator" previous_target_record_name="target_excavate_pose_1" primitive_name="primitive_excavator_change_pose_plan" target_record_name="target_excavate_pose_2"/>
            <Action  model_name="zx200" ID="LeafNodeExcavator" previous_target_record_name="target_excavate_pose_2" primitive_name="primitive_excavator_change_pose_plan" target_record_name="target_excavate_pose_3"/>
            <Action  model_name="zx200" ID="LeafNodeExcavator" previous_target_record_name="" primitive_name="primitive_excavator_change_pose_execute_from_plan" target_record_name="target_excavate_pose_1,target_excavate_pose_2,target_excavate_pose_3"/>
        </Sequence>
    </BehaviorTree>
    <!-- ////////// -->
    <TreeNodesModel>
        <Action ID="BlackboardValueReaderMongo">
            <input_port name="mongo_param_name"/>
            <input_port name="mongo_record_name"/>
            <input_port name="output_port"/>
        </Action>
        <Action ID="ConditionalExpression">
            <input_port name="conditional_expression"/>
        </Action>
        <Action ID="Counter">
            <input_port name="key"/>
        </Action>
        <Action ID="ExecuteSubtask">
            <input_port name="machine_record_name"/>
            <input_port name="model_name"/>
            <input_port name="subtask_name"/>
            <input_port name="subtask_parameters"/>
            <input_port name="terminate_condition"/>
        </Action>
        <Decorator ID="KeepRunningUntilFlgup">
            <input_port name="key"/>
            <input_port name="while_or_dowhile"/>
        </Decorator>
        <Action ID="LeafNodeBulldozer">
            <input_port default="d37pxi_24" name="model_name"/>
            <inout_port name="primitive_name"/>
            <inout_port name="record_name"/>
        </Action>
        <Action ID="LeafNodeCrawlerdump">
            <input_port name=" model_name"/>
            <inout_port name="primitive_name"/>
            <inout_port name="record_name"/>
        </Action>
        <Action ID="LeafNodeExcavator">
            <input_port default="zx200" name="model_name"/>
            <inout_port name="previous_target_record_name"/>
            <inout_port name="primitive_name"/>
            <inout_port name="target_record_name"/>
        </Action>
        <Action ID="LeafNodeExcavatorAssist">
            <input_port default="zx200" name="model_name"/>
            <inout_port name="primitive_name"/>
            <inout_port name="record_name"/>
        </Action>
        <Action ID="MongoValueWriter">
            <input_port name="input_value"/>
            <input_port name="mongo_param_name"/>
            <input_port name="mongo_record_name"/>
        </Action>
        <Action ID="SetLocalBlackboard">
            <inout_port name="output_key"/>
            <input_port name="value"/>
        </Action>
        <Action ID="SetLocalBlackboardWithCounter">
            <inout_port name="counter_key"/>
            <input_port name="key"/>
        </Action>
        <Action ID="WaitForClick">
            <input_port name="button_info"/>
            <input_port name="window_title"/>
        </Action>
    </TreeNodesModel>
    <!-- ////////// -->
</root>
