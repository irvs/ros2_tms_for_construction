<?xml version="1.0"?>
<root main_tree_to_execute="BehaviorTree">
    <!-- ////////// -->
    <BehaviorTree ID="BehaviorTree">
        <Sequence>
            <Sequence>
                <Action ID="MongoValueReader" mongo_param_name="" mongo_record_name="" output_port="set_height_input"/>
                <Action ID="SetLocalBlackboard" output_key="set_height" value="0.0"/>
                <Action ID="SetLocalBlackboard" output_key="set_height_offset" value="-0.1"/>
                <KeepRunningUntilFailure>
                    <Sequence>
                        <Action ID="LocalBlackboardCaluculator" calculation_formula="{set_height_offset} + 0.1" output_key="set_height_offset"/>
                        <Action ID="LocalBlackboardCaluculator" calculation_formula="{set_height_input} + {set_height_offset}" output_key="set_height"/>
                        <Action ID="LeafNodeBulldozer" model_name="d37pxi_24" primitive_name="primitive_bulldozer_blade_control" record_name="blade_up_height"/>
                        <Action ID="LeafNodeCrawlerDump" model_name="d37pxi_24" primitive_name="primitive_bulldozer_navigate_anywhere" read_direction="" record_name="origin"/>
                        <Action ID="LeafNodeBulldozer" model_name="d37pxi_24" primitive_name="primitive_bulldozer_blade_control" record_name="set_height"/>
                        <Action ID="LeafNodeCrawlerDump" model_name="d37pxi_24" primitive_name="primitive_bulldozer_navigate_anywhere" read_direction="up" record_name="push_1"/>
                    </Sequence>
                </KeepRunningUntilFailure>
            </Sequence>
            <Action ID="LeafNodeCrawlerDump" model_name="d37pxi_24" primitive_name="primitive_bulldozer_navigate_anywhere" read_direction="" record_name="origin"/>
            <Action ID="LeafNodeCrawlerDump" model_name="d37pxi_24" primitive_name="primitive_bulldozer_navigate_anywhere" read_direction="" record_name="push_2"/>
            <Action ID="LeafNodeCrawlerDump" model_name="d37pxi_24" primitive_name="primitive_bulldozer_navigate_anywhere" read_direction="" record_name="origin"/>
            <Action ID="LeafNodeCrawlerDump" model_name="d37pxi_24" primitive_name="primitive_bulldozer_navigate_anywhere" read_direction="" record_name="push_3"/>
            <Action ID="LeafNodeCrawlerDump" model_name="d37pxi_24" primitive_name="primitive_bulldozer_navigate_anywhere" read_direction="" record_name="origin"/>
        </Sequence>
    </BehaviorTree>
    <!-- ////////// -->
    <TreeNodesModel>
        <Action ID="ConditionalExpression">
            <input_port name="conditional_expression"/>
        </Action>
        <Action ID="Counter">
            <input_port name="key"/>
        </Action>
        <Action ID="ExecuteSubtask">
            <input_port name="machine_record_name"/>
            <input_port name="model_name"/>
            <input_port name="subtask_name"/>
            <input_port name="subtask_parameters"/>
            <input_port name="terminate_condition"/>
        </Action>
        <Decorator ID="KeepRunningUntilFlgup">
            <input_port name="key"/>
            <input_port name="while_or_dowhile"/>
        </Decorator>
        <Action ID="LeafNodeBulldozer">
            <input_port default="d37pxi_24" name="model_name"/>
            <inout_port name="primitive_name"/>
            <inout_port name="record_name"/>
        </Action>
        <Action ID="LeafNodeCommon">
            <input_port name="model_name"/>
            <inout_port name="primitive_name"/>
            <inout_port name="record_name"/>
        </Action>
        <Action ID="LeafNodeCrawlerDump">
            <input_port name="model_name"/>
            <inout_port name="primitive_name"/>
            <inout_port name="read_direction"/>
            <inout_port name="record_name"/>
        </Action>
        <Action ID="LeafNodeExcavator">
            <input_port default="zx200" name="model_name"/>
            <inout_port name="previous_target_record_name"/>
            <inout_port name="primitive_name"/>
            <inout_port name="target_record_name"/>
        </Action>
        <Action ID="LeafNodeExcavatorAssist">
            <input_port default="zx200" name="model_name"/>
            <inout_port name="primitive_name"/>
            <inout_port name="record_name"/>
        </Action>
        <Action ID="LocalBlackboardCaluculator">
            <input_port name="calculation_formula"/>
            <inout_port name="output_key"/>
        </Action>
        <Action ID="MongoArrayWriter">
            <input_port name="input_value"/>
            <input_port name="mongo_param_name"/>
            <input_port name="mongo_record_name"/>
            <input_port name="operation"/>
        </Action>
        <Action ID="MongoValueReader">
            <input_port name="mongo_param_name"/>
            <input_port name="mongo_record_name"/>
            <input_port name="output_port"/>
        </Action>
        <Action ID="MongoValueSearcher">
            <input_port name="mongo_param_name"/>
            <input_port name="mongo_value"/>
            <input_port name="output_port"/>
        </Action>
        <Action ID="MongoValueWriter">
            <input_port name="input_value"/>
            <input_port name="mongo_param_name"/>
            <input_port name="mongo_record_name"/>
        </Action>
        <Action ID="SetLocalBlackboard">
            <inout_port name="output_key"/>
            <input_port name="value"/>
        </Action>
        <Action ID="SetLocalBlackboardWithCounter">
            <inout_port name="counter_key"/>
            <input_port name="key"/>
        </Action>
        <Action ID="WaitForClick">
            <input_port name="button_info"/>
            <input_port name="window_title"/>
        </Action>
        <Action ID="WaitTimer">
            <input_port name="seconds"/>
        </Action>
    </TreeNodesModel>
    <!-- ////////// -->
</root>
