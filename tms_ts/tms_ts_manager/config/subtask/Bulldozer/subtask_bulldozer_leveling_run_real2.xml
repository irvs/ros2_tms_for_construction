<?xml version="1.0"?>
<root main_tree_to_execute="BehaviorTree">
    <!-- ////////// -->
    <BehaviorTree ID="BehaviorTree">
        <Sequence>
            <Sequence>
                <ForceSuccess>
                    <RetryUntilSuccessful num_attempts="2">
                        <Sequence>
                            <ForceSuccess>
                                <Action ID="LeafNodeBulldozer" model_name="d37pxi_24" primitive_name="primitive_bulldozer_blade_control" record_name="$blade_tilt_1$"/>
                            </ForceSuccess>
                            <Action ID="LeafNodeBulldozer" model_name="d37pxi_24" primitive_name="primitive_bulldozer_navigate_anywhere" record_name="origin_1"/>
                            <Action ID="LeafNodeBulldozer" model_name="d37pxi_24" primitive_name="primitive_bulldozer_navigate_anywhere" record_name="push_1"/>
                        </Sequence>
                    </RetryUntilSuccessful>
                </ForceSuccess>
            </Sequence>
            <Action ID="SetLocalBlackboard" output_key="counter" value="2"/>
            <Action ID="SetLocalBlackboard" output_key="origin_n" value="origin_0"/>
            <Action ID="SetLocalBlackboard" output_key="push_n" value="push_0"/>
            <Decorator ID="KeepRunningUntilFlgup" key="LEVELING_TERMINAL_FLG" while_or_dowhile="while">
                <Sequence>
                    <ForceSuccess>
                        <RetryUntilSuccessful num_attempts="2">
                            <Sequence>
                                <Action ID="SetLocalBlackboardWithCounter" counter_key="counter" key="push_n"/>
                                <Action ID="SetLocalBlackboardWithCounter" counter_key="counter" key="origin_n"/>
                                <ForceSuccess>
                                    <Action ID="LeafNodeBulldozer" model_name="d37pxi_24" primitive_name="primitive_bulldozer_blade_control" record_name="$blade_tilt_2$"/>
                                </ForceSuccess>
                                <Action ID="LeafNodeBulldozer" model_name="d37pxi_24" primitive_name="primitive_bulldozer_navigate_anywhere" record_name="{origin_n}"/>
                                <Action ID="LeafNodeBulldozer" model_name="d37pxi_24" primitive_name="primitive_bulldozer_navigate_anywhere" record_name="{push_n}"/>
                                <Action ID="Counter" key="counter"/>
                            </Sequence>
                        </RetryUntilSuccessful>
                    </ForceSuccess>
                    <IfThenElse>
                        <Action ID="ConditionalExpression" conditional_expression="counter == &quot;$leveling_time$&quot;"/>
                        <Action ID="SetLocalBlackboard" output_key="LEVELING_TERMINAL_FLG" value="true"/>
                        <AlwaysSuccess/>
                    </IfThenElse>
                </Sequence>
            </Decorator>
            <Action ID="SetLocalBlackboard" output_key="LEVELING_TERMINAL_FLG" value="false"/>
        </Sequence>
    </BehaviorTree>
    <!-- ////////// -->
    <TreeNodesModel>
        <Action ID="ConditionalExpression">
            <input_port name="conditional_expression"/>
        </Action>
        <Action ID="Counter">
            <input_port name="key"/>
        </Action>
        <Action ID="ExecuteSubtask">
            <input_port name="machine_record_name"/>
            <input_port name="model_name"/>
            <input_port name="subtask_name"/>
            <input_port name="subtask_parameters"/>
            <input_port name="terminate_condition"/>
        </Action>
        <Decorator ID="KeepRunningUntilFlgup">
            <input_port name="key"/>
            <input_port name="while_or_dowhile"/>
        </Decorator>
        <Action ID="LeafNodeBulldozer">
            <input_port default="d37pxi_24" name="model_name"/>
            <inout_port name="primitive_name"/>
            <inout_port name="record_name"/>
        </Action>
        <Action ID="LeafNodeCommon">
            <input_port name="model_name"/>
            <inout_port name="primitive_name"/>
            <inout_port name="record_name"/>
        </Action>
        <Action ID="LeafNodeCrawlerDump">
            <input_port name="model_name"/>
            <inout_port name="primitive_name"/>
            <inout_port name="read_direction"/>
            <inout_port name="record_name"/>
        </Action>
        <Action ID="LeafNodeExcavator">
            <input_port default="zx200" name="model_name"/>
            <inout_port name="previous_target_record_name"/>
            <inout_port name="primitive_name"/>
            <inout_port name="target_record_name"/>
        </Action>
        <Action ID="LeafNodeExcavatorAssist">
            <input_port default="zx200" name="model_name"/>
            <inout_port name="primitive_name"/>
            <inout_port name="record_name"/>
        </Action>
        <Action ID="LocalBlackboardCaluculator">
            <input_port name="calculation_formula"/>
            <inout_port name="output_key"/>
        </Action>
        <Action ID="MongoArrayWriter">
            <input_port name="input_value"/>
            <input_port name="mongo_param_name"/>
            <input_port name="mongo_record_name"/>
            <input_port name="operation"/>
        </Action>
        <Action ID="MongoValueReader">
            <input_port name="mongo_param_name"/>
            <input_port name="mongo_record_name"/>
            <input_port name="output_port"/>
        </Action>
        <Action ID="MongoValueSearcher">
            <input_port name="mongo_param_name"/>
            <input_port name="mongo_value"/>
            <input_port name="output_port"/>
        </Action>
        <Action ID="MongoValueWriter">
            <input_port name="input_value"/>
            <input_port name="mongo_param_name"/>
            <input_port name="mongo_record_name"/>
        </Action>
        <Action ID="SetLocalBlackboard">
            <inout_port name="output_key"/>
            <input_port name="value"/>
        </Action>
        <Action ID="SetLocalBlackboardWithCounter">
            <inout_port name="counter_key"/>
            <input_port name="key"/>
        </Action>
        <Action ID="WaitForClick">
            <input_port name="button_info"/>
            <input_port name="window_title"/>
        </Action>
        <Action ID="WaitTimer">
            <input_port name="seconds"/>
        </Action>
    </TreeNodesModel>
    <!-- ////////// -->
</root>
