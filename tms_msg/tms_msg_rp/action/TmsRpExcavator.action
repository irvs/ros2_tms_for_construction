# Goal
uint8 CMD_PLAN_TO_POSE=0
uint8 CMD_PLAN_TO_JOINTS=1
uint8 CMD_EXECUTE_PLAN=2
uint8 CMD_PLAN_CARTESIAN_PATH=3
uint8 CMD_CHECK_POSE_COLLISION=4

uint8 command
string planning_group

# CMD_PLAN_TO_POSE, CMD_PLAN_TO_JOINTS
geometry_msgs/Pose pose
tms_msg_rp/TmsRpExcavatorJointValues joint_values
moveit_msgs/RobotTrajectory[] previous_pose

# CMD_EXECUTE_PLAN
moveit_msgs/RobotTrajectory plan

# Constraints
moveit_msgs/Constraints constraints

---
# Result
bool success
int32 moveit_error_code
string message
moveit_msgs/RobotTrajectory plan  # CMD_PLAN_TO_POSE, CMD_PLAN_TO_JOINTS

---
# Feedback
string state
float32 progress
